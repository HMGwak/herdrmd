# Cargo build output and release/install packages
/target/
/dist/
/artifacts/

# Machine-local configuration and state; never use real Vault data as fixtures
/.env
/.env.*
!/.env.example
/.herdrmd/
/herdrmd-runtime/
/herdrmd-cache/
/registry.json
/integrations/herdr/mods/herdrmd/launcher.json
/service.json
/drafts/
/recovery/
/locks/
/cache/
/logs/
/config.local.*
*.local.toml
*.log

# Generated by herdr-app check; the installed app owns these API snapshots.
/integrations/herdr/mods/*/gpui-kit.d.ts
/integrations/herdr/mods/*/herdr.d.ts
/integrations/herdr/mods/*/jsconfig.json

# Editor and OS metadata
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
